{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "infomoney/currency-converter",
  "title": "Infomoney Currency Converter",
  "category": "widgets",
  "icon": "money-alt",
  "description": "Conversor de moedas usando o design system Infomoney.",
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "baseCurrency": {
      "type": "string",
      "default": "USD"
    },
    "targetCurrency": {
      "type": "string",
      "default": "BRL"
    }
  },
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}